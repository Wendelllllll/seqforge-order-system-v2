# Copy to /etc/seqforge/seqforgebio.env, readable only by the operator/root.
# Docker Compose >=2.30 reads this in raw mode: NO surrounding quotes.
# Values here are placeholders. Never commit the completed file.
# Percent-encode username/password characters in DATABASE_URL.
# Use the AWS database endpoint hostname, not an IP address.
DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@DB_ENDPOINT:5432/seqforge?schema=public&sslmode=require&sslaccept=strict&sslcert=/etc/seqforge/rds-ca.pem&connection_limit=5&connect_timeout=10
BETTER_AUTH_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Mail starts disabled to prevent unintended delivery. Real verification and
# password reset cannot be accepted until authorized SMTP is configured/tested.
INTERNAL_MAIL_MODE=off
# Replace with the explicitly approved internal notification recipient.
INTERNAL_MAIL_TO=ops@example.com
INTERNAL_MAIL_FROM=
CUSTOMER_MAIL_MODE=off
CUSTOMER_MAIL_FROM=
CUSTOMER_MAIL_ALLOWED_RECIPIENTS=
CONTACT_MAIL_MODE=off
CONTACT_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
