generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("customer")
  firstName     String
  lastName      String
  organization  String
  labName       String
  phone         String?
  orderDefaults Json?
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  customerPricing CustomerPricing?
  customerPricingChanges CustomerPricingChange[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([issuer, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Order {
  id                  String          @id @default(cuid())
  orderNumber         String          @unique
  submissionKey       String?
  submissionHash      String?
  pricingSnapshot     Json?
  fulfillmentSnapshot Json?
  oligoSnapshot       Json?
  userId              String
  service             String          @default("SANGER")
  intakeVersion       Int             @default(1)
  priority            String          @default("Standard")
  container           String          @default("Tubes")
  submissionMode      String          @default("Standard")
  orderNameKey        String?
  orderName           String
  poNumber            String?
  specialInstructions String?
  status              String          @default("SUBMITTED")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  completedAt         DateTime?
  user                User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  samples             Sample[]
  result              Result?
  statusHistory       StatusHistory[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@unique([userId, submissionKey])
}

model OrderCounter {
  month String @id
  value Int
}

model PricingSchedule {
  id        String   @id
  revision  Int
  rates     Json
  updatedAt DateTime @updatedAt
}

model PricingChange {
  id            String   @id @default(cuid())
  revision      Int      @unique
  actorId       String
  actorName     String
  reason        String
  previousRates Json
  rates         Json
  createdAt     DateTime @default(now())
}

model CustomerPricing {
  userId    String   @id
  revision  Int
  overrides Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model CustomerPricingChange {
  id                String   @id @default(cuid())
  customerId        String
  revision          Int
  actorId           String
  actorName         String
  reason            String
  previousOverrides Json
  overrides         Json
  createdAt         DateTime @default(now())
  customer          User     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([customerId, revision])
  @@index([customerId, createdAt])
}

model Sample {
  id            String  @id @default(cuid())
  orderId       String
  position      Int
  sampleName    String
  sampleKey     String  @default("")
  tubeLabel     String  @default("")
  plateLabel    String  @default("")
  well          String  @default("")
  templateLength String @default("")
  preparation   String  @default("None requested")
  templateType  String
  concentration String?
  primerName    String
  primerSource  String
  notes         String?
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reactions     Reaction[]

  @@unique([orderId, position])
  @@index([orderId])
}

model Reaction {
  id                    String @id @default(cuid())
  sampleId              String
  position              Int
  primerName            String
  primerSource          String
  primerConcentration   String @default("")
  storedPrimerReference String @default("")
  primerSequence        String @default("")
  purification          String @default("Desalted")
  synthesisScale        String @default("25 nmol")
  modification5         String @default("")
  modification3         String @default("")
  modificationInternal  String @default("")
  specialProtocol       String @default("None known")
  sample                Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@unique([sampleId, position])
}

model Result {
  id           String   @id @default(cuid())
  orderId      String   @unique
  originalName String
  storedName   String   @unique
  mimeType     String
  size         Int
  uploadedAt   DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model StatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// Internal staff notifications only. Preview records are never promoted to live mail.
model InternalNotification {
  id          String    @id
  eventKey    String    @unique
  kind        String
  recipient   String
  subject     String
  bodyText    String
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  claimToken  String?
  lockedUntil DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}

// Customer-only mail. PREVIEW and SUPPRESSED records never become live mail.
model CustomerNotification {
  id          String    @id
  eventKey    String    @unique
  userId      String
  kind        String
  recipient   String
  subject     String
  bodyText    String
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  claimToken  String?
  lockedUntil DateTime?
  expiresAt   DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, kind, createdAt])
}
