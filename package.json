{
  "name": "seqforge-order-system-v2",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "tsx --test tests/order-intake.test.ts tests/pricing.test.ts",
    "test:db": "tsx --test tests/order-persistence.test.ts",
    "db:import-sqlite": "tsx scripts/import-sqlite.ts",
    "db:deploy": "prisma migrate deploy",
    "test:smoke": "tsx scripts/smoke-ordering.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.2",
    "@prisma/client": "^6.19.3",
    "better-auth": "^1.7.2",
    "lucide-react": "^0.544.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
