{
  "name": "seqforge-order-system-v2",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-dropboxes": "tsx scripts/seed-dropboxes.ts",
    "db:studio": "prisma studio",
    "test": "tsx --test tests/order-intake.test.ts tests/pricing.test.ts tests/sanger-entry.test.ts tests/order-resume.test.ts tests/whole-plasmid.test.ts tests/oligo-entry.test.ts tests/oligo-backend.test.ts tests/customer-pricing.test.ts tests/customer-price-display.test.ts tests/internal-mail.test.ts tests/customer-mail.test.ts tests/request-origin.test.ts tests/dropboxes.test.ts tests/password-reset.test.ts",
    "test:db": "tsx --test tests/order-persistence.test.ts",
    "db:import-sqlite": "tsx scripts/import-sqlite.ts",
    "db:deploy": "prisma migrate deploy",
    "test:smoke": "node scripts/run-isolated-smoke.mjs",
    "test:mail-db": "tsx --test tests/internal-notifications.test.ts",
    "test:reset-db": "tsx --test tests/password-reset-db.test.ts",
    "test:auth-db": "tsx --test tests/auth-schema-upgrade.test.ts",
    "mail:status": "tsx scripts/internal-mail.ts status",
    "mail:test": "tsx scripts/internal-mail.ts test",
    "mail:flush": "tsx scripts/internal-mail.ts flush",
    "mail:retry": "tsx scripts/internal-mail.ts retry",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.15",
    "@prisma/client": "^6.19.3",
    "better-auth": "1.7.15",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
