DATABASE_URL="postgresql://seqforge:replace-with-database-password@localhost:5432/seqforge?schema=public"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
SHOW_DEMO_ACCOUNTS="false"

# Hosted deployments: set this to a persistent volume mount (not an ephemeral directory).
RESULT_STORAGE_PATH="storage/results"

# Internal staff reminders only. off = disabled; preview = save locally without sending.
# SMTP requires an authorized sending account. Never commit its password.
INTERNAL_MAIL_MODE="off"
INTERNAL_MAIL_TO=""
INTERNAL_MAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""

# Customer verification and order-confirmation mail are controlled separately.
# preview stores messages locally without sending. SMTP requires a list or explicit "*".
CUSTOMER_MAIL_MODE="off"
CUSTOMER_MAIL_FROM=""
CUSTOMER_MAIL_ALLOWED_RECIPIENTS=""
# "*" allows all customer addresses in local demos or production. Empty is not allow-all.
# Automated tests still block live SMTP. Use company-owned SMTP and HTTPS for production.

# Public contact form: fixed recipient info@seqforge.com, separate from staff alerts.
# off (default) or smtp. Uses existing SMTP settings; never reports preview as sent.
CONTACT_MAIL_MODE="off"
# Optional sender override; defaults to INTERNAL_MAIL_FROM, then CUSTOMER_MAIL_FROM.
CONTACT_MAIL_FROM=""
