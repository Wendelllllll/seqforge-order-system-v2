DATABASE_URL="postgresql://seqforge:replace-with-database-password@localhost:5432/seqforge?schema=public"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
SHOW_DEMO_ACCOUNTS="false"

# Hosted deployments: set this to a persistent volume mount (not an ephemeral directory).
RESULT_STORAGE_PATH="storage/results"

# Internal staff reminders only. off = disabled; preview = save locally without sending.
# SMTP requires an authorized sending account. Never commit its password.
INTERNAL_MAIL_MODE="off"
INTERNAL_MAIL_TO=""
INTERNAL_MAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""

# Customer verification and order-confirmation mail are controlled separately.
# preview stores messages locally without sending. Local SMTP requires an explicit list.
CUSTOMER_MAIL_MODE="off"
CUSTOMER_MAIL_FROM=""
CUSTOMER_MAIL_ALLOWED_RECIPIENTS=""
# Production only, after configuring company-owned SMTP and HTTPS: allow all with "*".
